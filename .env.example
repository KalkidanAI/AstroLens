# AstroLens Environment Variables Template
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# Stellarium Remote Control API
STELLARIUM_URL=http://localhost:8090
STELLARIUM_HOST=localhost
STELLARIUM_PORT=8090

# Hardware & Simulation Modes (mock, ascom, indi, opencv)
TELESCOPE_MODE=mock
TELESCOPE_PORT=COM3
CAMERA_MODE=mock
YOLO_MODEL_PATH=api/ml/model/best.pt

# Astronomical Verification Engine Weights
VISUAL_WEIGHT=0.40
POSITION_WEIGHT=0.35
TELESCOPE_WEIGHT=0.25

# Location defaults
DEFAULT_LATITUDE=9.03
DEFAULT_LONGITUDE=38.74
DEFAULT_TIMEZONE=Africa/Addis_Ababa
